---
import Layout from "../layouts/layout.astro";
import BlogCard from "../components/blogCard.astro";

//Datos
const recursos=[{

    title:"Tablón visual",
    description:"Infografías, resúmenes y cheatsheets compartidos por la comunidad.",
    link:"https://padlet.com/profeantoniogabriel/alixarcoders",
    buttonText:"Abrir Padlet",
    icon:"bi-grid-3x3-gap"

},
{
    title: "Canal de YouTube",
    description: "Tutoriales, charlas y grabaciones de la comunidad para aprender juntos.",
    link: "https://www.youtube.com/@alixarcoders",
    buttonText: "Visitar canal",
    icon: "bi-youtube"
}
    
];

const decalogo=[
    "⚙️ Compilamos calidad",
    "🐞 Depuramos nuestro código",
    "🔤 Escribimos código limpio y legible",
    "🧅 Estructuramos el código en capas",
    "📄 Documentamos el código con JavaDoc",
    "🤖 Usamos la IA como ayuda, pero entendemos el código",
    "🧪 Realizamos Tests Unitarios",
    "🔐 Tenemos en cuenta la ciberseguridad desde el 0'",
    "🌐 Somos Full Stack Developers (front + back)",
    "🙌 Tu código habla por ti"
]

---

<Layout>
    <!-- Hero -->
    <header class="py-5 bg-gradient-hero border-bottom">
        <div class="container py-4">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="badge rounded-pill bg-accent text-dark fw-semibold mb-3">
                        Backend · Frontend · DevOps · Sec
                    </span>

                    <h1 class="display-5 fw-bold mb-2">
                        Comunidad de Desarrolladores Web del I.E.S. ALIXAR
                    </h1>

                    <p class="lead fw-semibold text-primary mb-3">
                        Aprende, construye y despliega con <span class="text-accent">AlixarCoders</span>
                    </p>

                    <p class="lead text-body-secondary mb-4">
                        Repositorio central de la comunidad: cheatsheets, proyectos, estándares, eventos y enlaces a nuestros espacios (Github, LinkedIn, YouTube, Padlet,...).
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary btn-lg" href="https://github.com/AlixarCoders" target="_blank" rel="noopener">
                            <i class="bi bi-github me-1"></i> Github
                        </a>
                        <a class="btn btn-outline-primary btn-lg" href="https://www.linkedin.com/company/alixarcoders" target="_blank" rel="noopener">
                            <i class="bi bi-linkedin me-1"></i> Comunidad de Unicornios
                        </a>
                    </div>

                    <p class="lead fw-bold mt-4">
                        <span class="text-accent">¡</span>
                        <span class="text-ac-blue">Somos</span>
                        <span class="text-ac-violet">Unicornios</span>
                        <span class="text-accent">!</span>
                        <br />                            
                        <span class="text-accent">¡</span>
                        <span class="text-ac-blue">SOMOS</span>
                        <span class="text-ac-violet">FULL STACK</span>
                        <span class="text-ac-blue">WEB DEVELOPERS</span>
                        <span class="text-accent">!</span>
                    </p>
                </div>

                <div class="col-lg-5">
                    <div class="card shadow-sm overflow-hidden">
                        <div class="ratio ratio-4x3">
                            <img
                            src="/images/logo/unicornio.png"
                            alt="AlixarCoders unicornio"
                            class="w-100 h-100 object-fit-contain"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Sección Recursos / Blog -->
    <section id="recursos" class="py-5">
        <div class="container">
            <h2 class="h1 fw-bold mb-4">Recursos de la comunidad</h2>
            <div class="row g-4">
                {recursos.map((item) => (
                    <BlogCard
                    title={item.title}
                    description={item.description}
                    link={item.link}
                    buttonText={item.buttonText}
                    icon={item.icon}
                    />
                ))}
            </div>
        </div>
    </section>

    <!-- Decálogo -->
    <section id="normas" class="py-5 border-top">
        <div class="container">
            <h2 class="h1 fw-bold mb-2">Decálogo para 🌈 Unicornios de AlixarCoders</h2>
            <p class="h4 text-accent mb-4">🍝 Zona libre de código spaghetti</p>
            <ul class="list-group list-group-flush">
                {decalogo.map((norma) => (
                    <li class="list-group-item bg-transparent">{norma}</li>
                ))}
            </ul>
        </div>
    </section>
</Layout>