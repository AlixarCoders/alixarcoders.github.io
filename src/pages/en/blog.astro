---
import Layout from "../../layouts/layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const entradas = t("entradas") as any[];
---

<Layout title="AlixarCoders — Novedades y Blog">
    <section class="py-5 bg-gradient-hero border-bottom">
        <div class="container text-center">
            <h1 class="display-5 fw-bold mb-2">{t("layoutTitle")}</h1>
            <p class="lead text-body-secondary">{t("subtitulo")}</p>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row g-4">
                {
                    entradas.map((post) => (
                        <div class="col-md-6">
                            <article class="card h-100 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <span class="badge bg-primary mb-2 align-self-start">
                                        {post.categoria}
                                    </span>
                                    <h2 class="h4 card-title">{post.titulo}</h2>
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-calendar-event me-1" />{" "}
                                        {post.fecha}
                                    </p>
                                    <p class="card-text text-body-secondary">
                                        {post.resumen}
                                    </p>
                                </div>
                            </article>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
