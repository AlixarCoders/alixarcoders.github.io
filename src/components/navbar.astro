---
import Language from "./language.astro";
import SocialLinks from "./socialLinks.astro";
import Theme from "./theme.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

// Detectamos el idioma actual desde la URL (devuelve 'es' o 'en')
const lang = getLangFromUrl(Astro.url);

// Construimos la ruta base de inicio según el idioma
const homeUrl = lang === 'en' ? '/en' : '/';
---

<nav class="navbar navbar-expand-lg sticky-top bg-body-tertiary border-bottom">
    <div class="container">
        <!-- El logo redirige a / o a /en según el idioma activo -->
        <a
            class="navbar-brand d-flex align-items-center gap-2 fw-bold"
            href={homeUrl}
        >
            <img
                src="/images/logo/logo.svg"
                alt="AlixarCoders logo"
                class="logo-navbar d-inline-block align-text-top"
            />
            <span class="brand-text">
                <span class="text-ac-blue">Alixar</span><span
                    class="text-ac-violet">Coders</span
                >
            </span>
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNav"
            aria-controls="mainNav"
            aria-expanded="false"
            aria-label="Abrir navegación"
        >
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <!-- Links redes sociales y navegación interna traducida -->
                <SocialLinks />

                <!-- Theme switcher -->
                <Theme />

                <!-- Cambiador de idioma -->
                <Language />
            </ul>
        </div>
    </div>
</nav>