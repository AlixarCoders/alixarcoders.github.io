---
// src/components/socialLinks.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// La ruta del blog cambia según el idioma
const blogUrl = lang === 'en' ? '/en/blog' : '/blog';
---

<!-- Blog novedades -->
<li class="nav-item">
    <a
        class="nav-link"
        href="/blog"
    >
        <i class="bi bi-card-text me-1"></i>{t('novedades')}
    </a>
</li>

<!-- LinkedIn -->
<li class="nav-item">
    <a
        class="nav-link"
        href="https://www.linkedin.com/company/alixarcoders"
        target="_blank"
        rel="noopener"
    >
        <i class="bi bi-linkedin me-1"></i>{t('linkedin')}
    </a>
</li>

<!-- Padlet -->
<li class="nav-item">
    <a
        class="nav-link"
        href="https://padlet.com/profeantoniogabriel/alixarcoders"
        target="_blank"
        rel="noopener"
    >
        <i class="bi bi-grid-3x3-gap me-1"></i>{t('padlet')}
    </a>
</li>

<!-- YouTube -->
<li class="nav-item">
    <a
        class="nav-link"
        href="https://www.youtube.com/@alixarcoders"
        target="_blank"
        rel="noopener"
    >
        <i class="bi bi-youtube me-1"></i>{t('youtube')}
    </a>
</li>

<!-- Repositorios (GitHub) -->
<li class="nav-item">
    <a
        class="nav-link"
        href="https://github.com/AlixarCoders"
        target="_blank"
        rel="noopener"
    >
        <i class="bi bi-github me-1"></i>{t('git')}
    </a>
</li>

<!-- Zona privada DAW2 -->
<li class="nav-item">
    <a
        class="nav-link"
        href="https://sites.google.com/g.educaand.es/alixarcoders"
        target="_blank"
        rel="noopener"
    >
        <i class="bi bi-lock-fill me-1"></i>{t('zona')}
    </a>
</li>
